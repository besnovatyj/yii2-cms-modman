{
  "name": "modules/modman",
  "description": "Система управления модулями CMS (compile-not-patch).",
  "type": "yii2-extension",
  "license": "MIT",
  "require": {
    "besnovatyj/yii2-cms-kernel": "^1.0",
    "php": ">=8.4",
    "yiisoft/yii2": "~2.0.0",
    "besnovatyj/yii2-cms-contracts": "^1.0"
  },
  "suggest": {
    "composer/semver": "Полноценная проверка ограничений версий (^, ~, диапазоны) в зависимостях модулей"
  },
  "extra": {
    "bescms": {
      "kind": "module"
    },
    "moduleClass": "modules\\modman\\Module",
    "moduleId": "modman"
  },
  "autoload": {
    "psr-4": {
      "modules\\modman\\": ""
    }
  }
}

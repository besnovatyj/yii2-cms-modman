{
  "name": "besnovatyj/yii2-cms-modman",
  "description": "Система управления модулями Yii2 CMS (compile-not-patch): discovery, реестр состояния, компиляция производных конфигов, lifecycle установки/удаления модулей.",
  "type": "yii2-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "Besnovatyj",
      "email": "your-email@example.com"
    }
  ],
  "minimum-stability": "stable",
  "keywords": [
    "yii2",
    "cms",
    "modules",
    "module-manager",
    "modman"
  ],
  "config": {
    "sort-packages": true
  },
  "require": {
    "php": ">=8.4",
    "yiisoft/yii2": "~2.0.0",
    "besnovatyj/yii2-cms-kernel": "^1.0",
    "besnovatyj/yii2-cms-contracts": "^1.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest"
  },
  "suggest": {
    "composer/semver": "Полноценная проверка ограничений версий (^, ~, диапазоны) в зависимостях модулей"
  },
  "extra": {
    "bescms": {
      "kind": "module"
    },
    "moduleClass": "Besnovatyj\\Modman\\Module",
    "moduleId": "Modman",
    "config-plugin": {
      "admin-menu": "src/config/adminMenu.php"
    }
  },
  "autoload": {
    "psr-4": {
      "Besnovatyj\\Modman\\": "src/"
    }
  }
}
